    {
      "parameters": {
        "sendTo": "={{ $(\"Company Settings\").item.json.owner_email }}",
        "subject": "=New Roofing lead [{{ $(\"Analyze Request\").item.json.output[0].content[0].text.urgency }} urgency] - {{ $(\"Quote Request Form\").item.json.name }}",
        "message": "=<div style=\"background:#1976d2;color:white;padding:18px;text-align:center;font-size:24px;font-weight:bold;\">\n🏠 New Roofing Lead\n</div>\n\n<div style=\"padding:20px;font-family:Arial,sans-serif;max-width:700px;\">\n\n<p style=\"font-size:16px;\">\n<strong>Lead ID:</strong> {{ $(\"Edit Fields\").item.json.lead_id }}\n</p>\n\n<hr>\n\n<h2 style=\"color:#1976d2;\">📊 AI Lead Analysis</h2>\n\n<table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #ddd;\">\n\n<tr>\n<td width=\"35%\"><strong>Summary</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.summary }}</td>\n</tr>\n\n<tr>\n<td><strong>Job Type</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.job_type }}</td>\n</tr>\n\n<tr>\n<td><strong>Urgency</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.urgency }}</td>\n</tr>\n\n<tr>\n<td><strong>Lead Score</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.lead_score }}/100</td>\n</tr>\n\n<tr>\n<td><strong>Insurance Claim</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.insurance_claim ? \"✅ Yes\" : \"❌ No\" }}</td>\n</tr>\n\n<tr>\n<td><strong>Estimated Project Value</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.estimated_project_value }}</td>\n</tr>\n\n<tr>\n<td><strong>Customer Sentiment</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.customer_sentiment }}</td>\n</tr>\n\n<tr>\n<td><strong>Best Contact Method</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.ideal_contact_method }}</td>\n</tr>\n\n<tr>\n<td><strong>Recommended Action</strong></td>\n<td><strong>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.recommended_action }}</strong></td>\n</tr>\n\n</table>\n\n<br>\n\n<h2 style=\"color:#1976d2;\">👤 Customer Information</h2>\n\n<table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #ddd;\">\n\n<tr>\n<td width=\"35%\"><strong>Name</strong></td>\n<td>{{ $(\"Quote Request Form\").item.json.name }}</td>\n</tr>\n\n<tr>\n<td><strong>Email</strong></td>\n<td>\n<a href=\"mailto:{{ $(\"Quote Request Form\").item.json.email }}\">\n{{ $(\"Quote Request Form\").item.json.email }}\n</a>\n</td>\n</tr>\n\n<tr>\n<td><strong>Phone</strong></td>\n<td>\n<a href=\"tel:{{ $(\"Quote Request Form\").item.json.phone }}\">\n{{ $(\"Quote Request Form\").item.json.phone }}\n</a>\n</td>\n</tr>\n\n<tr>\n<td><strong>Best Time</strong></td>\n<td>{{ $(\"Quote Request Form\").item.json.best_time }}</td>\n</tr>\n\n<tr>\n<td><strong>Address</strong></td>\n<td>{{ $(\"Quote Request Form\").item.json.address }}</td>\n</tr>\n\n<tr>\n<td><strong>Requested Service</strong></td>\n<td>{{ $(\"Quote Request Form\").item.json.service_type }}</td>\n</tr>\n\n</table>\n\n<br>\n\n<h2 style=\"color:#1976d2;\">📝 Customer Notes</h2>\n\n<div style=\"background:#f7f7f7;padding:15px;border-left:4px solid #1976d2;\">\n{{ $(\"Quote Request Form\").item.json.details }}\n</div>\n\n<br>\n\n<h2 style=\"color:#1976d2;\">🤖 AI Sales Notes</h2>\n\n<div style=\"background:#f7f7f7;padding:15px;border-left:4px solid #1976d2;\">\n<pre style=\"white-space:pre-wrap;font-family:Arial,sans-serif;margin:0;\">{{ $(\"AI Sales Notes\").item.json.output[0].content[0].text }}</pre>\n</div>\n\n<br>\n\n<div style=\"background:#e8f5e9;padding:15px;border-radius:6px;text-align:center;\">\n<strong>Open Google Sheets to update the lead status after contacting the customer.</strong>\n</div>\n\n</div>",
        "options": {
          "replyTo": "={{ $(\"Quote Request Form\").item.json.email }}"
        }
      },
