    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "id"
        },
        "responses": {
          "values": [
            {
              "content": "=You are the AI office assistant for a professional roofing company.\n\nAnalyze the customer's request and determine:\n\n• A concise 2–3 sentence summary for the office.\n• The most appropriate job type.\n• The urgency (High, Medium, or Low).\n• A lead score from 1–100.\n• Whether an estimate is being requested.\n• Whether an insurance claim is likely.\n• Estimated project value (Low, Medium, High).\n• Customer sentiment (Calm, Concerned, Urgent).\n• Ideal first contact method (Phone or Email).\n• The best next action for the office.\n\nScoring Rules\n\nHIGH URGENCY\n- Active roof leak\n- Water entering the home\n- Storm, hail or wind damage\n- Tree on roof\n- Roof collapse\n- Emergency tarp request\n- Immediate service requested\n\nMEDIUM URGENCY\n- Roof repair\n- Missing shingles\n- Flashing damage\n- Small leak\n- Gutter issues\n- Ventilation problems\n\nLOW URGENCY\n- Routine inspection\n- Maintenance\n- Future roof replacement\n- General questions\n- Pricing inquiry\n\nLead Score\n\n90–100\nEmergency jobs, storm damage, insurance claims, full replacements, immediate scheduling.\n\n70–89\nRoof repairs, inspections, leaks, customers ready to schedule.\n\n40–69\nGeneral estimates and maintenance.\n\n1–39\nInformational questions only.\n\nEstimated Project Value\n\nHigh\n- Full roof replacement\n- Major storm damage\n- Commercial roofing\n\nMedium\n- Roof repairs\n- Leak repairs\n- Gutters\n\nLow\n- Inspection\n- Maintenance\n- Consultation\n\nCustomer Sentiment\n\nUrgent\n- Wants immediate help\n- Water entering home\n- Emergency\n\nConcerned\n- Worried about damage\n- Wants an estimate soon\n\nCalm\n- General inquiry\n- Planning ahead\n\nRecommended Action should be one short sentence.\n\nCustomer Information\n\nName:\n{{ $json.name }}\n\nSelected Service:\n{{ $json.service_type }}\n\nCustomer Description:\n{{ $json.details }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "instructions": "You are an AI assistant for a professional roofing company. Read the customer's roofing request and produce a concise 2-3 sentence summary for the business owner, a job_type classification, an urgency estimate, a lead_score from 1 to 100 (integer), a recommended_action, and estimate_requested (true/false). Set estimate_requested to true when the customer is requesting an estimate, quote, inspection, roof replacement, roof repair, insurance inspection, pricing, or wants to schedule a visit. Set it to false for general questions or informational inquiries. Base urgency on the following: High for active roof leaks, storm or hail damage, trees on roofs, roof collapses, water entering the home, emergency tarp requests, or requests for immediate service. Medium for missing shingles, flashing damage, roof repairs, small leaks, gutter issues, or ventilation problems. Low for routine inspections, future roof replacements, preventative maintenance, pricing inquiries, or general questions. Lead_score should reflect how valuable and ready-to-buy the lead is: 90-100 for emergency service, severe storm damage, insurance claims, or full roof replacements needing immediate attention; 70-89 for roof repairs, inspections, and customers ready to schedule; 40-69 for general estimate requests or maintenance; 1-39 for informational inquiries or customers not ready to move forward. Recommended_action should be one short instruction such as \"Call immediately and dispatch an emergency crew,\" \"Schedule a roof inspection within 24 hours,\" \"Contact the customer today with an estimate,\" or \"Email pricing information.\" Set insurance_claim to true if the customer mentions insurance, hail damage, storm damage, wind damage, filing a claim, or says they plan to use home owners insurance. otherwise set to false. Always return valid JSON that matches the provided schema exactly.",
          "textFormat": {
            "textOptions": {
              "type": "json_schema",
              "name": "roofing_lead_analysis",
              "schema": "={\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"properties\": {\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"job_type\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Roof Repair\",\n        \"Roof Replacement\",\n        \"Storm Damage\",\n        \"Leak Repair\",\n        \"Roof Inspection\",\n        \"Gutter Repair\",\n        \"Commercial Roofing\",\n        \"Other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"High\",\n        \"Medium\",\n        \"Low\"\n      ]\n    },\n    \"lead_score\": {\n      \"type\": \"integer\",\n      \"minimum\": 1,\n      \"maximum\": 100\n    },\n    \"recommended_action\": {\n      \"type\": \"string\"\n    },\n    \"estimate_requested\": {\n      \"type\": \"boolean\"\n    },\n    \"insurance_claim\": {\n      \"type\": \"boolean\"\n    },\n    \"estimated_project_value\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Low\",\n        \"Medium\",\n        \"High\"\n      ]\n    },\n    \"customer_sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Calm\",\n        \"Concerned\",\n        \"Urgent\"\n      ]\n    },\n    \"ideal_contact_method\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Phone\",\n        \"Email\"\n      ]\n    }\n  },\n  \"required\": [\n    \"summary\",\n    \"job_type\",\n    \"urgency\",\n    \"lead_score\",\n    \"recommended_action\",\n    \"estimate_requested\",\n    \"insurance_claim\",\n    \"estimated_project_value\",\n    \"customer_sentiment\",\n    \"ideal_contact_method\"\n  ]\n}",
              "description": "Analyzes roofing lead submissions and returns structured data including a summary, job type, urgency, lead score, recommended action, estimate request status, and insurance claim detection.",
              "strict": true
            }
          }
        }
      },
      "id": "9bad3765-14b7-4381-8a45-40b39491350d",
