        "message": "=<div style=\"background:#c62828;color:white;padding:22px;text-align:center;font-size:28px;font-weight:bold;\">\n🚨 EMERGENCY ROOFING LEAD\n</div>\n\n<div style=\"padding:20px;font-family:Arial,sans-serif;max-width:700px;\">\n\n<div style=\"background:#ffebee;border:2px solid #c62828;padding:15px;margin-bottom:20px;font-size:18px;\">\n<strong>Immediate Action Recommended</strong><br><br>\n\n{{ $(\"Analyze Request\").item.json.output[0].content[0].text.recommended_action }}\n</div>\n\n<p style=\"font-size:16px;\">\n<strong>Lead ID:</strong>\n{{ $(\"Edit Fields\").item.json.lead_id }}\n</p>\n\n<h2 style=\"color:#c62828;\">⚠ AI Emergency Analysis</h2>\n\n<table width=\"100%\" cellpadding=\"8\" cellspacing=\"0\" style=\"border-collapse:collapse;border:1px solid #ddd;\">\n\n<tr>\n<td><strong>Summary</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.summary }}</td>\n</tr>\n\n<tr>\n<td><strong>Lead Score</strong></td>\n<td style=\"font-size:22px;font-weight:bold;color:#c62828;\">\n{{ $(\"Analyze Request\").item.json.output[0].content[0].text.lead_score }}/100\n</td>\n</tr>\n\n<tr>\n<td><strong>Urgency</strong></td>\n<td style=\"color:#c62828;font-weight:bold;font-size:20px;\">\n🚨 {{ $(\"Analyze Request\").item.json.output[0].content[0].text.urgency }}\n</td>\n</tr>\n\n<tr>\n<td><strong>Estimated Project Value</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.estimated_project_value }}</td>\n</tr>\n\n<tr>\n<td><strong>Insurance Claim</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.insurance_claim ? \"✅ Likely\" : \"❌ No\" }}</td>\n</tr>\n\n<tr>\n<td><strong>Customer Sentiment</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.customer_sentiment }}</td>\n</tr>\n\n<tr>\n<td><strong>Best Contact Method</strong></td>\n<td>{{ $(\"Analyze Request\").item.json.output[0].content[0].text.ideal_contact_method }}</td>\n</tr>\n\n</table>\n\n<br>\n\n<h2 style=\"color:#c62828;\">📞 Contact Customer Immediately</h2>\n\n<p style=\"font-size:18px;\">\n<strong>{{ $(\"Quote Request Form\").item.json.name }}</strong>\n</p>\n\n<p>\n📧\n<a href=\"mailto:{{ $(\"Quote Request Form\").item.json.email }}\">\n{{ $(\"Quote Request Form\").item.json.email }}\n</a>\n</p>\n\n<p>\n📱\n<a href=\"tel:{{ $(\"Quote Request Form\").item.json.phone }}\">\n{{ $(\"Quote Request Form\").item.json.phone }}\n</a>\n</p>\n\n<p>\n📍\n{{ $(\"Quote Request Form\").item.json.address }}\n</p>\n\n<p>\n🕒\n{{ $(\"Quote Request Form\").item.json.best_time }}\n</p>\n\n<br>\n\n<h2 style=\"color:#c62828;\">Customer Description</h2>\n\n<div style=\"background:#fff8f8;padding:15px;border-left:5px solid #c62828;\">\n{{ $(\"Quote Request Form\").item.json.details }}\n</div>\n\n<br>\n\n<h2 style=\"color:#c62828;\">🤖 AI Sales Notes</h2>\n\n<div style=\"background:#fff8f8;padding:15px;border-left:5px solid #c62828;\">\n<pre style=\"white-space:pre-wrap;font-family:Arial,sans-serif;margin:0;\">{{ $(\"AI Sales Notes\").item.json.output[0].content[0].text }}</pre>\n</div>\n\n</div>",
